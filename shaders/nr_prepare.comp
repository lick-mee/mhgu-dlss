#version 450
// Shrinks DLAA's output, the depth and the motion vectors to the resolution DLSS Neural Rendering
// runs at (it refuses more than 2560x1440): a box filter for colour, the nearest sample for depth
// (averaging depths makes surfaces that do not exist), averaged and rescaled motion.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D color_tex;
layout(set = 0, binding = 1) uniform sampler2D depth_tex;
layout(set = 0, binding = 2) uniform sampler2D mv_tex;
layout(set = 0, binding = 3, rgba8) uniform writeonly image2D nr_color;
layout(set = 0, binding = 4, r32f) uniform writeonly image2D nr_depth;
layout(set = 0, binding = 5, rg16f) uniform writeonly image2D nr_mv;
layout(push_constant) uniform PC {
	ivec2 size;   // NR resolution
	int factor;   // full resolution = size * factor
} pc;

void main()
{
	ivec2 p = ivec2(gl_GlobalInvocationID.xy);
	if (p.x >= pc.size.x || p.y >= pc.size.y)
		return;
	ivec2 base = p * pc.factor;
	vec4 c = vec4(0.0);
	vec2 mv = vec2(0.0);
	for (int y = 0; y < pc.factor; y++)
		for (int x = 0; x < pc.factor; x++) {
			c += texelFetch(color_tex, base + ivec2(x, y), 0);
			mv += texelFetch(mv_tex, base + ivec2(x, y), 0).xy;
		}
	float n = float(pc.factor * pc.factor);
	imageStore(nr_color, p, c / n);
	imageStore(nr_depth, p, vec4(texelFetch(depth_tex, base + ivec2(pc.factor / 2), 0).r));
	imageStore(nr_mv, p, vec4(mv / n / float(pc.factor), 0.0, 0.0));
}
